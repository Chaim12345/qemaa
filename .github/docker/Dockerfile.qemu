FROM ubuntu:22.04 AS builder

ARG QEMU_VERSION=9.0.0
ARG NDK_VERSION=30-beta3
ARG ANDROID_API=36

# The QEMU emulator is cross-compiled for EVERY supported host ABI (the guest
# machine stays x86_64 in all cases — qemu-system-x86_64 emulates a PC on any
# 64-bit host via TCG):
#   x86_64    -> for x86_64 devices/emulators
#   arm64-v8a -> for physical phones (the overwhelming majority)
# Bundling a single ABI leaves all other devices without a QEMU binary, because
# Android extracts only the libraries of the device's primary ABI at install
# time (the app then reports "Missing required assets: QEMU binary").
ENV ABIS="x86_64 arm64-v8a"

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_API=${ANDROID_API}

RUN apt-get update && apt-get install -y \
    autoconf automake bash bc bison build-essential bzip2 ca-certificates \
    cmake curl file flex gawk gettext git libtool lzip make ninja-build patch \
    pkg-config python3 python3-pip python3-venv python3-packaging \
    unzip wget xz-utils zip zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install meson==1.6.1

RUN wget -q https://dl.google.com/android/repository/android-ndk-r${NDK_VERSION}-linux.zip \
    && unzip -q android-ndk-r${NDK_VERSION}-linux.zip -d /opt \
    && rm android-ndk-r${NDK_VERSION}-linux.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk-r${NDK_VERSION}
ENV PATH="${ANDROID_NDK_HOME}:${PATH}"

# ── Per-ABI compiler wrappers, pkg-config wrappers and meson cross files ─────
# Generated with Python to avoid heredoc/shell-quoting issues. For each ABI:
#   /usr/local/bin/android-cc-<abi>         clang wrapper (drops -Werror)
#   /usr/local/bin/android-cxx-<abi>        clang++ wrapper (drops -Werror)
#   /usr/local/bin/android-pkg-config-<abi> pkg-config limited to that prefix
#   /build/cross-<abi>.txt                  meson cross file
#   /android-prefix/<abi>                   install prefix for static deps
RUN python3 - <<'PYEOF'
import os, stat

os.makedirs("/build", exist_ok=True)

ndk = os.environ["ANDROID_NDK_HOME"]
api = os.environ["ANDROID_API"]
tc = f"{ndk}/toolchains/llvm/prebuilt/linux-x86_64"

abis = {
    "x86_64": "x86_64-linux-android",
    "arm64-v8a": "aarch64-linux-android",
}

for abi, target in abis.items():
    prefix = f"/android-prefix/{abi}"
    clang = f"{tc}/bin/{target}{api}-clang"
    clangxx = f"{tc}/bin/{target}{api}-clang++"

    wrapper_c = f"""#!/bin/bash
args=()
for a in "$@"; do
  case "$a" in -Werror) ;; *) args+=("$a");; esac
done
exec {clang} -w "${{args[@]}}"
"""

    wrapper_cxx = f"""#!/bin/bash
args=()
for a in "$@"; do
  case "$a" in -Werror) ;; *) args+=("$a");; esac
done
exec {clangxx} -w "${{args[@]}}"
"""

    pkg_cfg = f"""#!/bin/sh
export PKG_CONFIG_DIR=
export PKG_CONFIG_LIBDIR={prefix}/lib/pkgconfig
exec /usr/bin/pkg-config "$@"
"""

    for path, content in [
        (f"/usr/local/bin/android-cc-{abi}", wrapper_c),
        (f"/usr/local/bin/android-cxx-{abi}", wrapper_cxx),
        (f"/usr/local/bin/android-pkg-config-{abi}", pkg_cfg),
    ]:
        with open(path, "w") as f:
            f.write(content)
        os.chmod(path, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)

    sysroot = f"{tc}/sysroot"
    cpu_family = "x86_64" if abi == "x86_64" else "aarch64"
    cross = f"""[binaries]
c = '/usr/local/bin/android-cc-{abi}'
cpp = '/usr/local/bin/android-cxx-{abi}'
ar = '{tc}/bin/llvm-ar'
strip = '{tc}/bin/llvm-strip'
pkgconfig = '/usr/local/bin/android-pkg-config-{abi}'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['--sysroot={sysroot}', '-I{prefix}/include', '-DANDROID', '-fPIC']
cpp_args = ['--sysroot={sysroot}', '-I{prefix}/include', '-DANDROID', '-fPIC']
c_link_args = ['--sysroot={sysroot}', '-L{prefix}/lib', '-fPIE', '-pie']
cpp_link_args = ['--sysroot={sysroot}', '-L{prefix}/lib', '-fPIE', '-pie']

[host_machine]
system = 'android'
cpu_family = '{cpu_family}'
cpu = '{cpu_family}'
endian = 'little'
"""
    with open(f"/build/cross-{abi}.txt", "w") as f:
        f.write(cross)
    os.makedirs(f"{prefix}", exist_ok=True)

print("Wrappers and cross files written OK")
PYEOF

# ── zlib ──────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN set -eux; \
    wget -q https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz; \
    tar xzf zlib-1.3.1.tar.gz; \
    for ABI in ${ABIS}; do \
      case "${ABI}" in \
        x86_64)    CHOST=x86_64-linux-android ;; \
        arm64-v8a) CHOST=aarch64-linux-android ;; \
      esac; \
      rm -rf /build/zlib-${ABI}; \
      cp -a /build/zlib-1.3.1 /build/zlib-${ABI}; \
      cd /build/zlib-${ABI}; \
      sed -i 's/-Werror//g' configure; \
      TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64; \
      CC=/usr/local/bin/android-cc-${ABI} \
      AR=${TOOLCHAIN}/bin/llvm-ar \
      RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
      CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC" \
      LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
      CHOST=${CHOST} \
      ./configure --prefix=/android-prefix/${ABI} --static \
      && make -j$(nproc) \
      && make install; \
    done; \
    rm -rf /build/zlib-1.3.1 /build/zlib-*.tar.gz

# ── libffi ────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN set -eux; \
    wget -q https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz; \
    tar xzf libffi-3.4.6.tar.gz; \
    for ABI in ${ABIS}; do \
      case "${ABI}" in \
        x86_64)    HOST=x86_64-linux-android ;; \
        arm64-v8a) HOST=aarch64-linux-android ;; \
      esac; \
      rm -rf /build/libffi-${ABI}; \
      cp -a /build/libffi-3.4.6 /build/libffi-${ABI}; \
      cd /build/libffi-${ABI}; \
      TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64; \
      ./configure \
        --host=${HOST} \
        --prefix=/android-prefix/${ABI} \
        --enable-static --disable-shared \
        CC=/usr/local/bin/android-cc-${ABI} \
        CXX=/usr/local/bin/android-cxx-${ABI} \
        AR=${TOOLCHAIN}/bin/llvm-ar \
        RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
        CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC -DANDROID" \
        LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
      && make -j$(nproc) \
      && make install; \
    done; \
    rm -rf /build/libffi-3.4.6 /build/libffi-*.tar.gz

# ── pcre2 ────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN set -eux; \
    wget -q https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.bz2; \
    tar xjf pcre2-10.43.tar.bz2; \
    for ABI in ${ABIS}; do \
      case "${ABI}" in \
        x86_64)    HOST=x86_64-linux-android ;; \
        arm64-v8a) HOST=aarch64-linux-android ;; \
      esac; \
      rm -rf /build/pcre2-${ABI}; \
      cp -a /build/pcre2-10.43 /build/pcre2-${ABI}; \
      cd /build/pcre2-${ABI}; \
      TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64; \
      ./configure \
        --host=${HOST} \
        --prefix=/android-prefix/${ABI} \
        --enable-static --disable-shared \
        --disable-pcre2grep --disable-pcre2test --disable-jit \
        CC=/usr/local/bin/android-cc-${ABI} \
        CXX=/usr/local/bin/android-cxx-${ABI} \
        AR=${TOOLCHAIN}/bin/llvm-ar \
        RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
        CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC -DANDROID" \
        LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
      && make -j$(nproc) \
      && make install; \
    done; \
    rm -rf /build/pcre2-10.43 /build/pcre2-*.tar.bz2

# ── pixman ───────────────────────────────────────────────────────────────────
WORKDIR /build
RUN set -eux; \
    wget -q https://www.cairographics.org/releases/pixman-0.43.4.tar.gz; \
    tar xzf pixman-0.43.4.tar.gz; \
    for ABI in ${ABIS}; do \
      rm -rf /build/pixman-build-${ABI}; \
      meson setup /build/pixman-build-${ABI} /build/pixman-0.43.4 \
        --cross-file /build/cross-${ABI}.txt \
        --prefix=/android-prefix/${ABI} \
        --buildtype=release \
        -Ddefault_library=static \
        -Dtests=disabled \
        -Ddemos=disabled \
        --wrap-mode=nodownload \
      && meson compile -C /build/pixman-build-${ABI} -j$(nproc) \
      && meson install -C /build/pixman-build-${ABI}; \
    done; \
    rm -rf /build/pixman-0.43.4 /build/pixman-*.tar.gz

# ── glib ─────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN set -eux; \
    wget -q https://download.gnome.org/sources/glib/2.80/glib-2.80.5.tar.xz; \
    tar xf glib-2.80.5.tar.xz; \
    mkdir -p glib-2.80.5/subprojects; \
    wget -q https://github.com/frida/proxy-libintl/archive/refs/tags/0.4.tar.gz -O proxy-libintl.tar.gz; \
    tar xzf proxy-libintl.tar.gz -C glib-2.80.5/subprojects; \
    mv glib-2.80.5/subprojects/proxy-libintl-0.4 glib-2.80.5/subprojects/proxy-libintl; \
    rm -f proxy-libintl.tar.gz; \
    for ABI in ${ABIS}; do \
      rm -rf /build/glib-build-${ABI}; \
      meson setup /build/glib-build-${ABI} /build/glib-2.80.5 \
        --cross-file /build/cross-${ABI}.txt \
        --prefix=/android-prefix/${ABI} \
        --buildtype=release \
        -Ddefault_library=static \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Ddocumentation=false \
        -Dman=false \
        -Dman-pages=disabled \
        -Dintrospection=disabled \
        -Dlibmount=disabled \
        -Dselinux=disabled \
        -Dsysprof=disabled \
        -Dnls=disabled \
        -Dglib_debug=disabled \
        -Dbsymbolic_functions=false \
        -Dxattr=false \
        --wrap-mode=nodownload \
      && meson compile -C /build/glib-build-${ABI} -j$(nproc) \
      && meson install -C /build/glib-build-${ABI}; \
    done; \
    rm -rf /build/glib-2.80.5 /build/glib-2.80.5.tar.xz

# ── libdl stub ────────────────────────────────────────────────────────────────
# glib's libgmodule/gio reference dlopen/dlsym/dlclose/dlerror, but bionic only
# provides them in the shared libdl.so, so a fully static link needs a stub.
# QEMU builds with modules disabled, so it is safe for these to be no-ops.
# Also stub shm_open/shm_unlink (bionic only has them for API >= 26), which are
# referenced by some of QEMU's test binaries.
WORKDIR /build
RUN set -eux; \
    printf '%s\n' \
      '#include <dlfcn.h>' \
      '#include <errno.h>' \
      '#include <sys/types.h>' \
      'void *dlopen(const char *name, int flags) { (void)name; (void)flags; return 0; }' \
      'int dlclose(void *h) { (void)h; return 0; }' \
      'void *dlsym(void *h, const char *sym) { (void)h; (void)sym; return 0; }' \
      'char *dlerror(void) { return "static link: dl* unavailable"; }' \
      'int shm_open(const char *name, int oflag, mode_t mode) { (void)name; (void)oflag; (void)mode; errno = ENOSYS; return -1; }' \
      'int shm_unlink(const char *name) { (void)name; errno = ENOSYS; return -1; }' \
      > android_stubs.c; \
    for ABI in ${ABIS}; do \
      /usr/local/bin/android-cc-${ABI} -c android_stubs.c -o android_stubs-${ABI}.o \
      && ${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar \
         rcs /android-prefix/${ABI}/lib/libdl.a android_stubs-${ABI}.o; \
    done

# ── libslirp ──────────────────────────────────────────────────────────────────
# QEMU's user-mode networking backend (-net user). QEMU 9.0 looks up slirp via
# pkg-config only (no subproject fallback), so it must be installed into each
# ABI prefix. Uses the GitHub mirror because gitlab.freedesktop.org archive URLs
# are served behind an anti-bot interstitial.
WORKDIR /build
RUN set -eux; \
    wget -q https://github.com/qemu/libslirp/archive/refs/tags/v4.8.0.tar.gz -O libslirp.tar.gz; \
    tar xzf libslirp.tar.gz; \
    for ABI in ${ABIS}; do \
      rm -rf /build/libslirp-build-${ABI}; \
      meson setup /build/libslirp-build-${ABI} /build/libslirp-4.8.0 \
        --cross-file /build/cross-${ABI}.txt \
        --prefix=/android-prefix/${ABI} \
        --buildtype=release \
        -Ddefault_library=static \
        --wrap-mode=nodownload \
      && meson compile -C /build/libslirp-build-${ABI} -j$(nproc) \
      && meson install -C /build/libslirp-build-${ABI}; \
    done; \
    rm -rf /build/libslirp-4.8.0 /build/libslirp.tar.gz

# ── QEMU ─────────────────────────────────────────────────────────────────────
# One source tree, one out-of-tree build dir per host ABI. The target stays
# x86_64-softmmu for both: the emulated machine is always a PC; only the host
# architecture differs.
WORKDIR /qemu
RUN wget -q https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz \
    && tar xf qemu-${QEMU_VERSION}.tar.xz --strip-components=1 \
    && rm qemu-${QEMU_VERSION}.tar.xz

# Sanity gate for every produced binary (run BEFORE stripping — strip removes
# the symbol table the slirp check needs). A binary that fails any check must
# never make it into the APK.
#   * ELF machine must match the intended host ABI
#   * dynamic bionic linking (INTERP /system/bin/linker64 + NEEDED libc.so) —
#     a static-PIE binary segfaults on Android because its TLS bootstrap uses
#     stale self-relocation data
#   * libslirp compiled in (the user network backend)
#   * 16 KiB LOAD alignment (required by 16 KiB-page devices, harmless on 4 KiB)
WORKDIR /qemu
RUN set -eux; \
    mkdir -p /out; \
    for ABI in ${ABIS}; do \
      case "${ABI}" in \
        x86_64)    MACHINE="Advanced Micro Devices X86-64" ;; \
        arm64-v8a) MACHINE="AArch64" ;; \
      esac; \
      rm -rf /qemu/build-${ABI}; \
      TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64; \
      SYSROOT=${TOOLCHAIN}/sysroot; \
      cd /qemu; \
      mkdir -p /qemu/build-${ABI}; \
      cd /qemu/build-${ABI}; \
      export PKG_CONFIG_PATH=/android-prefix/${ABI}/lib/pkgconfig; \
      export PKG_CONFIG_LIBDIR=/android-prefix/${ABI}/lib/pkgconfig; \
      ../configure \
        --target-list=x86_64-softmmu \
        --cross-prefix= \
        --cc=/usr/local/bin/android-cc-${ABI} \
        --cxx=/usr/local/bin/android-cxx-${ABI} \
        --host-cc=gcc \
        --prefix=/qemu/install-${ABI} \
        --enable-system \
        --disable-linux-user \
        --disable-bsd-user \
        --disable-docs \
        --disable-tools \
        --disable-guest-agent \
        --disable-spice \
        --disable-libusb \
        --disable-usb-redir \
        --disable-sdl \
        --disable-gtk \
        --disable-vnc \
        --disable-opengl \
        --disable-curses \
        --disable-libssh \
        --disable-virtfs \
        --disable-tpm \
        --disable-kvm \
        --disable-werror \
        --disable-plugins \
        --enable-pie \
        --disable-iconv \
        -Dvhost_user=disabled \
        -Dvhost_kernel=disabled \
        -Dvhost_vdpa=disabled \
        -Dvhost_net=disabled \
        -Dvhost_crypto=disabled \
        --extra-cflags="-I/android-prefix/${ABI}/include -I${SYSROOT}/usr/include -fPIC -DANDROID -Wno-implicit-function-declaration" \
        --extra-ldflags="-L/android-prefix/${ABI}/lib -L${SYSROOT}/usr/lib -ldl -Wl,--allow-multiple-definition" \
      && make -j$(nproc); \
      BIN=/qemu/build-${ABI}/qemu-system-x86_64; \
      file ${BIN}; \
      readelf -hW ${BIN} | grep -q "${MACHINE}"; \
      readelf -lW ${BIN} | grep -q "/system/bin/linker64"; \
      readelf -dW ${BIN} | grep -q "NEEDED"; \
      readelf -dW ${BIN} | grep -q "Shared library: \[libc.so\]"; \
      python3 -c "import subprocess,sys; out=subprocess.run(['readelf','-lW','${BIN}'],capture_output=True,text=True).stdout; a=[int(l.split()[-1],16) for l in out.splitlines() if l.startswith('  LOAD')]; sys.exit(0 if a and min(a)>=16384 else 1)"; \
      nm ${BIN} | grep -q "slirp_new"; \
      mkdir -p /out/${ABI}; \
      cp ${BIN} /out/${ABI}/qemu-system-x86_64; \
      ${TOOLCHAIN}/bin/llvm-strip --strip-unneeded /out/${ABI}/qemu-system-x86_64; \
      readelf -lW /out/${ABI}/qemu-system-x86_64 | grep -q "/system/bin/linker64"; \
      echo "qemu ${ABI} sanity: OK (machine=${MACHINE}, dynamic bionic, slirp enabled, stripped)"; \
    done; \
    ls -la /out/x86_64 /out/arm64-v8a

# ── Firmware subset ───────────────────────────────────────────────────────────
# QEMU loads x86 firmware at runtime: the SeaBIOS image (bios-256k.bin for the
# default q35 machine), the direct-kernel-boot ROMs (linuxboot*), and the
# virtio-net option ROM. Ship only those; the rest of the source pc-bios/
# belongs to other machines and would bloat the APK by tens of MB.
# NOTE: the prebuilt firmware lives in the SOURCE tree /qemu/pc-bios (the build
# dir only holds generated files), so bundle into a separate directory.
RUN mkdir -p /qemu-firmware \
    && cd /qemu/pc-bios \
    && cp bios.bin bios-256k.bin linuxboot.bin linuxboot_dma.bin \
         multiboot.bin multiboot_dma.bin pvh.bin kvmvapic.bin \
         vgabios.bin vgabios-stdvga.bin vgabios-cirrus.bin vgabios-virtio.bin \
         vgabios-vmware.bin vgabios-qxl.bin \
         efi-virtio.rom pxe-virtio.rom \
         /qemu-firmware/ \
    && ls -la /qemu-firmware/

# ── Final image ───────────────────────────────────────────────────────────────
FROM ubuntu:22.04
COPY --from=builder /out/x86_64/qemu-system-x86_64 /qemu/x86_64/qemu-system-x86_64
COPY --from=builder /out/arm64-v8a/qemu-system-x86_64 /qemu/arm64-v8a/qemu-system-x86_64
COPY --from=builder /qemu-firmware /qemu/pc-bios
CMD ["ls", "-la", "/qemu/"]
