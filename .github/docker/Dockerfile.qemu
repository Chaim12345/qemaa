FROM ubuntu:22.04 AS builder

ARG QEMU_VERSION=9.0.0
ARG ANDROID_ABI=x86_64
ARG NDK_VERSION=26b
ARG ANDROID_API=24

ENV DEBIAN_FRONTEND=noninteractive

# Install build tools and the native tools needed while cross-compiling GLib.
# python3-packaging is required by GLib's Meson build (find_installation(modules:
# ['packaging'])); it is not part of a bare python3 install on Ubuntu 22.04.
RUN apt-get update && apt-get install -y \
    autoconf automake bash bc bison build-essential bzip2 ca-certificates \
    cmake curl file flex gawk gettext git libtool lzip make meson ninja-build patch \
    pkg-config python3 python3-packaging python3-pip python3-venv \
    unzip wget xz-utils zip zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Download Android NDK.
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://dl.google.com/android/repository/android-ndk-r${NDK_VERSION}-linux.zip \
    && unzip -q android-ndk-r${NDK_VERSION}-linux.zip -d /opt \
    && rm android-ndk-r${NDK_VERSION}-linux.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk-r${NDK_VERSION}
ENV PATH="${ANDROID_NDK_HOME}:${PATH}"
ENV PREFIX=/android-prefix

# Ubuntu 22.04 ships Meson 0.61, which is too old for the dependencies used
# below: pixman >= 0.43 is Meson-only and GLib 2.80 requires Meson >= 1.2.0.
RUN pip3 install --no-cache-dir "meson==1.4.2" && meson --version

# Set up the Android compiler wrappers and a pkg-config that cannot accidentally
# resolve libraries from the Linux build host.
RUN TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 && \
    case "${ANDROID_ABI}" in \
      x86_64) \
        echo '#!/bin/bash' > /usr/local/bin/android-cc && \
        echo "exec ${TOOLCHAIN}/bin/x86_64-linux-android${ANDROID_API}-clang \"\$@\"" >> /usr/local/bin/android-cc && \
        echo '#!/bin/bash' > /usr/local/bin/android-cxx && \
        echo "exec ${TOOLCHAIN}/bin/x86_64-linux-android${ANDROID_API}-clang++ \"\$@\"" >> /usr/local/bin/android-cxx \
        ;; \
      arm64-v8a) \
        echo '#!/bin/bash' > /usr/local/bin/android-cc && \
        echo "exec ${TOOLCHAIN}/bin/aarch64-linux-android${ANDROID_API}-clang \"\$@\"" >> /usr/local/bin/android-cc && \
        echo '#!/bin/bash' > /usr/local/bin/android-cxx && \
        echo "exec ${TOOLCHAIN}/bin/aarch64-linux-android${ANDROID_API}-clang++ \"\$@\"" >> /usr/local/bin/android-cxx \
        ;; \
      *) echo "Unsupported Android ABI: ${ANDROID_ABI}" >&2; exit 1 ;; \
    esac && \
    chmod +x /usr/local/bin/android-cc /usr/local/bin/android-cxx && \
    printf '%s\n' \
      '#!/bin/sh' \
      'export PKG_CONFIG_DIR=' \
      'export PKG_CONFIG_LIBDIR=/android-prefix/lib/pkgconfig' \
      'exec /usr/bin/pkg-config "$@"' \
      > /usr/local/bin/android-pkg-config && \
    chmod +x /usr/local/bin/android-pkg-config

ENV CC=/usr/local/bin/android-cc
ENV CXX=/usr/local/bin/android-cxx
ENV PKG_CONFIG_PATH=/android-prefix/lib/pkgconfig
ENV PKG_CONFIG_LIBDIR=/android-prefix/lib/pkgconfig
RUN mkdir -p ${PREFIX}

# Write the Meson cross-compilation file shared by the pixman and GLib builds.
RUN TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 && \
    SYSROOT=${TOOLCHAIN}/sysroot && \
    case "${ANDROID_ABI}" in \
      x86_64) CPU_FAMILY=x86_64; CPU=x86_64 ;; \
      arm64-v8a) CPU_FAMILY=aarch64; CPU=aarch64 ;; \
      *) echo "Unsupported Android ABI: ${ANDROID_ABI}" >&2; exit 1 ;; \
    esac && \
    mkdir -p /build && \
    printf '%s\n' \
      '[binaries]' \
      "c = '/usr/local/bin/android-cc'" \
      "cpp = '/usr/local/bin/android-cxx'" \
      "ar = '${TOOLCHAIN}/bin/llvm-ar'" \
      "strip = '${TOOLCHAIN}/bin/llvm-strip'" \
      "pkg-config = '/usr/local/bin/android-pkg-config'" \
      '' \
      '[properties]' \
      'needs_exe_wrapper = true' \
      '' \
      '[built-in options]' \
      "c_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
      "cpp_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
      "c_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
      "cpp_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
      '' \
      '[host_machine]' \
      "system = 'android'" \
      "cpu_family = '${CPU_FAMILY}'" \
      "cpu = '${CPU}'" \
      "endian = 'little'" \
      > /build/android-cross.txt && \
    cat /build/android-cross.txt

# Build zlib.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://zlib.net/fossils/zlib-1.3.1.tar.gz && \
    tar xzf zlib-1.3.1.tar.gz && cd zlib-1.3.1 && \
    TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 && \
    case "${ANDROID_ABI}" in \
      x86_64) export CHOST=x86_64-linux-android ;; \
      arm64-v8a) export CHOST=aarch64-linux-android ;; \
    esac && \
    CC=${CC} AR=${TOOLCHAIN}/bin/llvm-ar RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
    CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC" \
    LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
    ./configure --prefix=${PREFIX} --static && \
    make -j$(nproc) && make install

# Build libffi, required by GLib.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz && \
    tar xzf libffi-3.4.6.tar.gz && cd libffi-3.4.6 && \
    TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 && \
    case "${ANDROID_ABI}" in \
      x86_64) export HOST=x86_64-linux-android ;; \
      arm64-v8a) export HOST=aarch64-linux-android ;; \
    esac && \
    ./configure --host=${HOST} --prefix=${PREFIX} --enable-static --disable-shared \
      CC=${CC} CXX=${CXX} AR=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar RANLIB=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib \
      CFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot -fPIC -DANDROID" \
      LDFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot" && \
    make -j$(nproc) && make install

# Build PCRE2, required by GLib's regular-expression support.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.bz2 && \
    tar xjf pcre2-10.43.tar.bz2 && cd pcre2-10.43 && \
    case "${ANDROID_ABI}" in \
      x86_64) export HOST=x86_64-linux-android ;; \
      arm64-v8a) export HOST=aarch64-linux-android ;; \
    esac && \
    ./configure --host=${HOST} --prefix=${PREFIX} --enable-static --disable-shared \
      --disable-pcre2grep --disable-pcre2test --disable-jit \
      CC=${CC} CXX=${CXX} AR=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar RANLIB=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib \
      CFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot -fPIC -DANDROID" \
      LDFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot" && \
    make -j$(nproc) && make install

# Android's libc does not provide iconv (bionic only gained it in API 26,
# while this image targets API 24), so build GNU libiconv as a static
# Android dependency. GLib 2.80 detects iconv automatically; do NOT pass
# -Diconv=external because the iconv Meson option was removed from GLib
# before 2.80.5. Meson resolves dependency('iconv') by first trying libc
# and then find_library('iconv'), which picks up
# ${PREFIX}/lib/libiconv.a through -L${PREFIX}/lib in the cross file.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://ftp.gnu.org/pub/gnu/libiconv/libiconv-1.17.tar.gz && \
    tar xzf libiconv-1.17.tar.gz && cd libiconv-1.17 && \
    case "${ANDROID_ABI}" in \
      x86_64) export HOST=x86_64-linux-android ;; \
      arm64-v8a) export HOST=aarch64-linux-android ;; \
    esac && \
    ./configure --host=${HOST} --prefix=${PREFIX} --enable-static --disable-shared \
      CC=${CC} AR=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar \
      RANLIB=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib \
      CFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot -fPIC -DANDROID" \
      LDFLAGS="--sysroot=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot" && \
    make -j$(nproc) && make install && \
    printf '%s\n' \
      'prefix=/android-prefix' \
      'exec_prefix=${prefix}' \
      'libdir=${exec_prefix}/lib' \
      'includedir=${prefix}/include' \
      '' \
      'Name: iconv' \
      'Description: GNU character set conversion library' \
      'Version: 1.17' \
      'Libs: -L${libdir} -liconv' \
      'Cflags: -I${includedir}' \
      > ${PREFIX}/lib/pkgconfig/iconv.pc

# Build pixman with Meson; pixman 0.43+ no longer ships autotools.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://www.cairographics.org/releases/pixman-0.43.4.tar.gz && \
    tar xzf pixman-0.43.4.tar.gz && \
    meson setup /build/pixman-build /build/pixman-0.43.4 \
      --cross-file /build/android-cross.txt \
      --prefix=${PREFIX} \
      --buildtype=release \
      -Ddefault_library=static \
      -Dtests=disabled \
      -Ddemos=disabled \
      -Dgtk=disabled \
      -Dlibpng=disabled \
      -Dopenmp=disabled \
      --wrap-mode=nodownload && \
    meson compile -C /build/pixman-build -j$(nproc) && \
    meson install -C /build/pixman-build

# Vendored copy of proxy-libintl (https://github.com/frida/proxy-libintl,
# tag 0.4 - exactly the revision referenced by GLib's subprojects/
# proxy-libintl.wrap). GLib needs an intl implementation; bionic does not
# provide gettext, so GLib falls back to the proxy-libintl Meson subproject.
# Because the GLib build uses --wrap-mode=nodownload, the subproject source
# has to be present in the unpacked GLib tree before `meson setup` runs.
COPY .github/docker/proxy-libintl /build/proxy-libintl

# Build GLib for Android. QEMU requires GLib at link time; using the Ubuntu
# host copy here would produce a Linux binary that cannot run on Android.
WORKDIR /build
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://download.gnome.org/sources/glib/2.80/glib-2.80.5.tar.xz && \
    tar xf glib-2.80.5.tar.xz && \
    cp -r /build/proxy-libintl /build/glib-2.80.5/subprojects/proxy-libintl && \
    meson setup /build/glib-build /build/glib-2.80.5 \
      --cross-file /build/android-cross.txt \
      --prefix=${PREFIX} \
      --buildtype=release \
      -Ddefault_library=static \
      -Dtests=false \
      -Dinstalled_tests=false \
      -Ddocumentation=false \
      -Dman-pages=disabled \
      -Dintrospection=disabled \
      -Dlibmount=disabled \
      -Dselinux=disabled \
      -Dsysprof=disabled \
      -Dnls=disabled \
      -Dglib_debug=disabled \
      -Dbsymbolic_functions=false \
      -Dxattr=false \
      --wrap-mode=nodownload && \
    meson compile -C /build/glib-build -j$(nproc) && \
    meson install -C /build/glib-build && \
    sed -i '/^Libs:/ s|$| -lintl -liconv -lpcre2-8|' \
      ${PREFIX}/lib/pkgconfig/glib-2.0.pc \
      ${PREFIX}/lib/pkgconfig/gthread-2.0.pc && \
    grep -H '^Libs:' ${PREFIX}/lib/pkgconfig/glib-2.0.pc \
      ${PREFIX}/lib/pkgconfig/gthread-2.0.pc

# GLib was built as a static library, so its own dependencies (the vendored
# libintl replacement, GNU libiconv and pcre2) end up under "Libs.private"
# in the Meson-generated pkg-config files above.  pkg-config omits
# Libs.private for ordinary lookups, which would leave QEMU's final link
# with undefined references; the sed above therefore appends the static
# closure to the public Libs line instead.

# Download and build QEMU for the selected Android host ABI.
WORKDIR /qemu
RUN wget -q --tries=5 --waitretry=10 --timeout=60 https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz && \
    tar xf qemu-${QEMU_VERSION}.tar.xz --strip-components=1

WORKDIR /qemu/build
# A blank --cross-prefix switches QEMU's configure into cross-compilation
# mode: it emits a Meson *cross* file (complete with a [host_machine]
# section) instead of a native file, so Meson only compiles - never runs -
# its sanity-check executable on the Linux build host, and it points a
# native file at gcc for build-time tools.  The blank prefix keeps --cc,
# --cxx and the environment-provided NDK binutils in charge of the actual
# compilation.
#
# vhost is disabled wholesale: it requires /dev/vhost-* kernel support that
# does not exist on Android, and QEMU's vendored libvhost-user virtio UAPI
# headers (subprojects/libvhost-user/standard-headers/linux/virtio_*.h)
# collide with the NDK sysroot's own linux/virtio_*.h (redefinition errors)
# because the cross file reports the host system as 'linux'.
#
# The final binary is a dynamic PIE executable: PIE is the standard (and on
# modern Android required) executable form, and linking dynamically against
# bionic while keeping every dependency static avoids the -static-pie
# toolchain limitation (bionic only supports static PIE from API 29).
RUN TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 && \
    SYSROOT=${TOOLCHAIN}/sysroot && \
    AR=${TOOLCHAIN}/bin/llvm-ar \
    NM=${TOOLCHAIN}/bin/llvm-nm \
    RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
    STRIP=${TOOLCHAIN}/bin/llvm-strip \
    ../configure \
      --cross-prefix= \
      --target-list=x86_64-softmmu \
      --cc=${CC} --cxx=${CXX} --host-cc=gcc --prefix=/qemu/install \
      --enable-system --disable-linux-user \
      --disable-bsd-user --disable-docs --disable-tools --disable-guest-agent \
      --disable-spice --disable-libusb --disable-usb-redir --disable-sdl \
      --disable-gtk --disable-vnc --disable-opengl --disable-curses \
      --disable-libssh --disable-virtfs --disable-tpm --disable-kvm \
      --disable-gio --disable-werror --enable-pie \
      --disable-vhost-user --disable-vhost-net --disable-vhost-kernel \
      --disable-vhost-vdpa --disable-vhost-user-blk-server \
      --disable-vhost-crypto --disable-libvduse --disable-vduse-blk-export \
      --disable-multiprocess --disable-vfio-user-server \
      --extra-cflags="-I${PREFIX}/include -I${SYSROOT}/usr/include -fPIC -DANDROID" \
      --extra-ldflags="-L${PREFIX}/lib -L${SYSROOT}/usr/lib -fPIE -pie" && \
    make -j$(nproc)

# Final stage contains only the executable copied by the GitHub Actions job.
FROM ubuntu:22.04
COPY --from=builder /qemu/build/qemu-system-x86_64 /qemu/
CMD ["ls", "-la", "/qemu/"]
