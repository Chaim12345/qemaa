FROM ubuntu:22.04 AS builder

ARG QEMU_VERSION=9.0.0
ARG ANDROID_ABI=x86_64
ARG NDK_VERSION=30-beta3
ARG ANDROID_API=36

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_ABI=${ANDROID_ABI}
ENV ANDROID_API=${ANDROID_API}

RUN apt-get update && apt-get install -y \
    autoconf automake bash bc bison build-essential bzip2 ca-certificates \
    cmake curl file flex gawk gettext git libtool lzip make ninja-build patch \
    pkg-config python3 python3-pip python3-venv python3-packaging \
    unzip wget xz-utils zip zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install meson==1.6.1

RUN wget -q https://dl.google.com/android/repository/android-ndk-r${NDK_VERSION}-linux.zip \
    && unzip -q android-ndk-r${NDK_VERSION}-linux.zip -d /opt \
    && rm android-ndk-r${NDK_VERSION}-linux.zip

ENV ANDROID_NDK_HOME=/opt/android-ndk-r${NDK_VERSION}
ENV PATH="${ANDROID_NDK_HOME}:${PATH}"
ENV PREFIX=/android-prefix

# Build compiler wrappers using a Python script to avoid heredoc/shell-quoting issues
RUN python3 - <<'PYEOF'
import os, stat

ndk   = os.environ["ANDROID_NDK_HOME"]
api   = os.environ["ANDROID_API"]
abi   = os.environ["ANDROID_ABI"]
tc    = f"{ndk}/toolchains/llvm/prebuilt/linux-x86_64"

target_map = {"x86_64": "x86_64-linux-android", "arm64-v8a": "aarch64-linux-android"}
target = target_map.get(abi)
if not target:
    raise SystemExit(f"Unsupported ABI: {abi}")

clang   = f"{tc}/bin/{target}{api}-clang"
clangxx = f"{tc}/bin/{target}{api}-clang++"

wrapper_c = f"""#!/bin/bash
args=()
for a in "$@"; do
  case "$a" in -Werror) ;; *) args+=("$a");; esac
done
exec {clang} -w "${{args[@]}}"
"""

wrapper_cxx = f"""#!/bin/bash
args=()
for a in "$@"; do
  case "$a" in -Werror) ;; *) args+=("$a");; esac
done
exec {clangxx} -w "${{args[@]}}"
"""

pkg_cfg = """#!/bin/sh
export PKG_CONFIG_DIR=
export PKG_CONFIG_LIBDIR=/android-prefix/lib/pkgconfig
exec /usr/bin/pkg-config "$@"
"""

for path, content in [
    ("/usr/local/bin/android-cc",         wrapper_c),
    ("/usr/local/bin/android-cxx",        wrapper_cxx),
    ("/usr/local/bin/android-pkg-config", pkg_cfg),
]:
    with open(path, "w") as f:
        f.write(content)
    os.chmod(path, stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP | stat.S_IROTH | stat.S_IXOTH)

print("Wrappers written OK")
PYEOF

ENV CC=/usr/local/bin/android-cc
ENV CXX=/usr/local/bin/android-cxx
ENV PKG_CONFIG_PATH=/android-prefix/lib/pkgconfig
ENV PKG_CONFIG_LIBDIR=/android-prefix/lib/pkgconfig
RUN mkdir -p ${PREFIX}

# ── zlib ──────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN wget -q https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz \
    && tar xzf zlib-1.3.1.tar.gz \
    && cd zlib-1.3.1 \
    && sed -i 's/-Werror//g' configure \
    && TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && case "${ANDROID_ABI}" in \
         x86_64)    export CHOST=x86_64-linux-android ;; \
         arm64-v8a) export CHOST=aarch64-linux-android ;; \
       esac \
    && CC=${CC} \
       AR=${TOOLCHAIN}/bin/llvm-ar \
       RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
       CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC" \
       LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
       ./configure --prefix=${PREFIX} --static \
    && make -j$(nproc) \
    && make install

# ── libffi ────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN wget -q https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz \
    && tar xzf libffi-3.4.6.tar.gz \
    && cd libffi-3.4.6 \
    && TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && case "${ANDROID_ABI}" in \
         x86_64)    export HOST=x86_64-linux-android ;; \
         arm64-v8a) export HOST=aarch64-linux-android ;; \
       esac \
    && ./configure \
         --host=${HOST} \
         --prefix=${PREFIX} \
         --enable-static --disable-shared \
         CC=${CC} CXX=${CXX} \
         AR=${TOOLCHAIN}/bin/llvm-ar \
         RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
         CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC -DANDROID" \
         LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
    && make -j$(nproc) \
    && make install

# ── pcre2 ────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN wget -q https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.43/pcre2-10.43.tar.bz2 \
    && tar xjf pcre2-10.43.tar.bz2 \
    && cd pcre2-10.43 \
    && TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && case "${ANDROID_ABI}" in \
         x86_64)    export HOST=x86_64-linux-android ;; \
         arm64-v8a) export HOST=aarch64-linux-android ;; \
       esac \
    && ./configure \
         --host=${HOST} \
         --prefix=${PREFIX} \
         --enable-static --disable-shared \
         --disable-pcre2grep --disable-pcre2test --disable-jit \
         CC=${CC} CXX=${CXX} \
         AR=${TOOLCHAIN}/bin/llvm-ar \
         RANLIB=${TOOLCHAIN}/bin/llvm-ranlib \
         CFLAGS="--sysroot=${TOOLCHAIN}/sysroot -fPIC -DANDROID" \
         LDFLAGS="--sysroot=${TOOLCHAIN}/sysroot" \
    && make -j$(nproc) \
    && make install

# ── pixman ───────────────────────────────────────────────────────────────────
WORKDIR /build
RUN wget -q https://www.cairographics.org/releases/pixman-0.43.4.tar.gz \
    && tar xzf pixman-0.43.4.tar.gz \
    && TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && SYSROOT=${TOOLCHAIN}/sysroot \
    && case "${ANDROID_ABI}" in \
         x86_64)    CPU_FAMILY=x86_64; CPU=x86_64 ;; \
         arm64-v8a) CPU_FAMILY=aarch64; CPU=aarch64 ;; \
       esac \
    && printf '%s\n' \
         '[binaries]' \
         "c = '/usr/local/bin/android-cc'" \
         "cpp = '/usr/local/bin/android-cxx'" \
         "ar = '${TOOLCHAIN}/bin/llvm-ar'" \
         "strip = '${TOOLCHAIN}/bin/llvm-strip'" \
         "pkgconfig = '/usr/local/bin/android-pkg-config'" \
         '' \
         '[properties]' \
         'needs_exe_wrapper = true' \
         '' \
         '[built-in options]' \
         "c_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
         "cpp_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
         "c_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
         "cpp_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
         '' \
         '[host_machine]' \
         "system = 'android'" \
         "cpu_family = '${CPU_FAMILY}'" \
         "cpu = '${CPU}'" \
         "endian = 'little'" \
       > /build/pixman-cross.txt \
    && meson setup /build/pixman-build /build/pixman-0.43.4 \
         --cross-file /build/pixman-cross.txt \
         --prefix=${PREFIX} \
         --buildtype=release \
         -Ddefault_library=static \
         -Dtests=disabled \
         -Ddemos=disabled \
         --wrap-mode=nodownload \
    && meson compile -C /build/pixman-build -j$(nproc) \
    && meson install -C /build/pixman-build

# ── glib ─────────────────────────────────────────────────────────────────────
WORKDIR /build
RUN wget -q https://download.gnome.org/sources/glib/2.80/glib-2.80.5.tar.xz \
    && tar xf glib-2.80.5.tar.xz \
    && mkdir -p glib-2.80.5/subprojects \
    && wget -q https://github.com/frida/proxy-libintl/archive/refs/tags/0.4.tar.gz -O proxy-libintl.tar.gz \
    && tar xzf proxy-libintl.tar.gz -C glib-2.80.5/subprojects \
    && mv glib-2.80.5/subprojects/proxy-libintl-0.4 glib-2.80.5/subprojects/proxy-libintl \
    && rm -f proxy-libintl.tar.gz \
    && TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && SYSROOT=${TOOLCHAIN}/sysroot \
    && case "${ANDROID_ABI}" in \
         x86_64)    CPU_FAMILY=x86_64; CPU=x86_64 ;; \
         arm64-v8a) CPU_FAMILY=aarch64; CPU=aarch64 ;; \
       esac \
    && printf '%s\n' \
         '[binaries]' \
         "c = '/usr/local/bin/android-cc'" \
         "cpp = '/usr/local/bin/android-cxx'" \
         "ar = '${TOOLCHAIN}/bin/llvm-ar'" \
         "strip = '${TOOLCHAIN}/bin/llvm-strip'" \
         "pkgconfig = '/usr/local/bin/android-pkg-config'" \
         '' \
         '[properties]' \
         'needs_exe_wrapper = true' \
         '' \
         '[built-in options]' \
         "c_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
         "cpp_args = ['--sysroot=${SYSROOT}', '-I${PREFIX}/include', '-DANDROID', '-fPIC']" \
         "c_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
         "cpp_link_args = ['--sysroot=${SYSROOT}', '-L${PREFIX}/lib', '-fPIE', '-pie']" \
         '' \
         '[host_machine]' \
         "system = 'android'" \
         "cpu_family = '${CPU_FAMILY}'" \
         "cpu = '${CPU}'" \
         "endian = 'little'" \
       > /build/android-cross.txt \
    && meson setup /build/glib-build /build/glib-2.80.5 \
         --cross-file /build/android-cross.txt \
         --prefix=${PREFIX} \
         --buildtype=release \
         -Ddefault_library=static \
         -Dtests=false \
         -Dinstalled_tests=false \
         -Ddocumentation=false \
         -Dman=false \
         -Dman-pages=disabled \
         -Dintrospection=disabled \
         -Dlibmount=disabled \
         -Dselinux=disabled \
         -Dsysprof=disabled \
         -Dnls=disabled \
         -Dglib_debug=disabled \
         -Dbsymbolic_functions=false \
         -Dxattr=false \
         --wrap-mode=nodownload \
    && meson compile -C /build/glib-build -j$(nproc) \
    && meson install -C /build/glib-build

# ── libdl stub ────────────────────────────────────────────────────────────────
# glib's libgmodule/gio reference dlopen/dlsym/dlclose/dlerror, but bionic only
# provides them in the shared libdl.so, so a fully static link needs a stub.
# QEMU builds with modules disabled, so it is safe for these to be no-ops.
# Also stub shm_open/shm_unlink (bionic only has them for API >= 26), which are
# referenced by some of QEMU's test binaries.
WORKDIR /build
RUN printf '%s\n' \
      '#include <dlfcn.h>' \
      '#include <errno.h>' \
      '#include <sys/types.h>' \
      'void *dlopen(const char *name, int flags) { (void)name; (void)flags; return 0; }' \
      'int dlclose(void *h) { (void)h; return 0; }' \
      'void *dlsym(void *h, const char *sym) { (void)h; (void)sym; return 0; }' \
      'char *dlerror(void) { return "static link: dl* unavailable"; }' \
      'int shm_open(const char *name, int oflag, mode_t mode) { (void)name; (void)oflag; (void)mode; errno = ENOSYS; return -1; }' \
      'int shm_unlink(const char *name) { (void)name; errno = ENOSYS; return -1; }' \
      > android_stubs.c \
    && ${CC} -c android_stubs.c -o android_stubs.o \
    && ${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar rcs ${PREFIX}/lib/libdl.a android_stubs.o

# ── QEMU ─────────────────────────────────────────────────────────────────────
WORKDIR /qemu
RUN wget -q https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz \
    && tar xf qemu-${QEMU_VERSION}.tar.xz --strip-components=1

WORKDIR /qemu/build
RUN TOOLCHAIN=${ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64 \
    && SYSROOT=${TOOLCHAIN}/sysroot \
    && ../configure \
         --target-list=x86_64-softmmu \
         --cross-prefix= \
         --cc=${CC} \
         --cxx=${CXX} \
         --host-cc=gcc \
         --prefix=/qemu/install \
         --enable-system \
         --disable-linux-user \
         --disable-bsd-user \
         --disable-docs \
         --disable-tools \
         --disable-guest-agent \
         --disable-spice \
         --disable-libusb \
         --disable-usb-redir \
         --disable-sdl \
         --disable-gtk \
         --disable-vnc \
         --disable-opengl \
         --disable-curses \
         --disable-libssh \
         --disable-virtfs \
         --disable-tpm \
         --disable-kvm \
         --disable-werror \
         --disable-plugins \
         --enable-pie \
         --disable-iconv \
         -Dvhost_user=disabled \
         -Dvhost_kernel=disabled \
         -Dvhost_vdpa=disabled \
         -Dvhost_net=disabled \
         -Dvhost_crypto=disabled \
         --extra-cflags="-I${PREFIX}/include -I${SYSROOT}/usr/include -fPIC -DANDROID -Wno-implicit-function-declaration" \
         --extra-ldflags="-L${PREFIX}/lib -L${SYSROOT}/usr/lib -ldl -Wl,--allow-multiple-definition" \
    && make -j$(nproc) \
    && file /qemu/build/qemu-system-x86_64 \
    && readelf -lW /qemu/build/qemu-system-x86_64 | grep -q "/system/bin/linker64" \
    && readelf -dW /qemu/build/qemu-system-x86_64 | grep -q NEEDED \
    && echo "qemu binary sanity: OK (dynamically linked against bionic)"

# ── Final image ───────────────────────────────────────────────────────────────
FROM ubuntu:22.04
COPY --from=builder /qemu/build/qemu-system-x86_64 /qemu/qemu-system-x86_64
CMD ["ls", "-la", "/qemu/"]
